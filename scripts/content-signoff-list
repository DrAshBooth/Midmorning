#!/bin/bash
# Prints every catalogue id, sorted, one per line, for the "Sign-off list"
# section of Packages/Content/SIGNOFF.md. Run by hand and paste the result
# in; not part of ./verify.
#
# Usage: scripts/content-signoff-list
set -euo pipefail
cd "$(dirname "$0")/.."
exec swift run --package-path Packages content-signoff-list
