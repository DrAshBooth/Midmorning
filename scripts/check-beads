#!/usr/bin/env python3
"""Read-only: confirm every bead's spec_id resolves to a file and a heading."""
import json, pathlib, subprocess, sys
root = pathlib.Path(__file__).resolve().parents[1]
out = subprocess.run(["bd", "export"], cwd=root, capture_output=True, text=True, check=True).stdout
misses = 0
for line in out.splitlines():
    if not line.strip():
        continue
    row = json.loads(line)
    spec = row.get("spec_id") or ""
    if not spec:
        continue
    path, _, anchor = spec.partition("#")
    file = root / path
    if not file.exists():
        print(f"{row['id']}: missing file {path}"); misses += 1; continue
    if anchor and not path.endswith("tasks.md"):
        if f"### Requirement: {anchor}" not in file.read_text():
            print(f"{row['id']}: no heading '### Requirement: {anchor}' in {path}"); misses += 1
print(f"{misses} miss(es)")
sys.exit(1 if misses else 0)
