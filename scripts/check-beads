#!/usr/bin/env python3
"""Read-only checks on the bead set. Run by hand; not part of ./verify.

1. Every spec_id resolves to a file, and its anchor to a heading:
   a `### Requirement:` line in a spec, or a `## ` heading or a
   `- [ ] <n> ` item in tasks.md.
2. Every `- <id> builds "<scenario>"` line in an acceptance names a bead
   whose description lists `"<scenario>" from <this bead>`.
"""
import json, pathlib, re, subprocess, sys
root = pathlib.Path(__file__).resolve().parents[1]
out = subprocess.run(["bd", "export"], cwd=root, capture_output=True, text=True, check=True).stdout
rows = {r["id"]: r for r in (json.loads(l) for l in out.splitlines() if l.strip())}
misses, empty = [], []
for i, row in rows.items():
    spec = row.get("spec_id") or ""
    if not spec:
        empty.append(i); continue
    path, _, anchor = spec.partition("#")
    file = root / path
    if not file.exists():
        misses.append(f"{i}: missing file {path}"); continue
    if not anchor:
        continue
    text = file.read_text()
    if path.endswith("tasks.md"):
        ok = (re.search(rf"^## {re.escape(anchor)}$", text, re.M)
              or re.search(rf"^\s*- \[[ x]\] {re.escape(anchor)} ", text, re.M))
    else:
        ok = re.search(rf"^### Requirement: {re.escape(anchor)}$", text, re.M)
    if not ok:
        misses.append(f"{i}: no heading for #{anchor} in {path}")
ptr = re.compile(r'^- (mm-[\w.]+) builds "(.*)"(?: \(only .*\))?$', re.M)
for i, row in rows.items():
    for target, scen in ptr.findall(row.get("acceptance_criteria") or ""):
        t = rows.get(target)
        if t is None:
            misses.append(f"{i}: points at missing bead {target}")
        elif f'"{scen}" from {i}' not in (t.get("description") or ""):
            misses.append(f'{i}: {target} does not list "{scen}" from {i}')
for m in misses:
    print(m)
print(f"{len(empty)} bead(s) with no spec_id: {', '.join(sorted(empty)) or 'none'}")
print(f"{len(misses)} miss(es)")
sys.exit(1 if misses else 0)
