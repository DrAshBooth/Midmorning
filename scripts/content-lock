#!/bin/bash
# Writes Packages/Content/Resources/content-lock.json for the bundle as it
# is on disk. The hash covers the cards, the bundle strings and the keys of
# App/Midmorning/Localizable.xcstrings that
# Packages/Content/Resources/signed-catalogue-keys.json names. Run by hand
# after a content change or a change to a signed catalogue string; not part
# of ./verify.
#
# Usage: scripts/content-lock <version>
set -euo pipefail
cd "$(dirname "$0")/.."
exec swift run --package-path Packages content-lock "$@"
