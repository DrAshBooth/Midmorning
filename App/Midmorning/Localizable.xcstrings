    },
    "settings.privacyNotice.apple.body": {
      "extractionState": "manual",
      "localizations": {
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple is a recipient of your data when you turn sync on. Apple holds it in Apple's own data centres. Apple cannot read your entries. The team never reads what you write."
          }
        }
      }
    },
    "settings.privacyNotice.apple.heading": {
      "extractionState": "manual",
      "localizations": {
        "en-GB": {
          "stringUnit": {
